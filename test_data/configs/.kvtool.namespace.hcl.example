# .kvtool.hcl - kvtool 設定ファイル（HCL 形式・namespace 対応）
#
# 構文:
# - locals { ... }              : 変数定義（HCL 標準）
# - local.var                   : 変数参照（HCL 標準）
# - env.VAR                     : 環境変数展開（kvtool 拡張）
# - namespaces { namespace "name" { ... } } : namespace 定義

# 変数定義
locals {
  config = {
    environment = "development"
  }
}

# namespace 対応形式（YAML と構造が一致）
namespaces {
  # default namespace
  namespace "default" {
    vault {
      driver = "vault"
      args {
        endpoint = env.VAULT_ADDR
        token    = env.VAULT_TOKEN
        path     = "secret/${local.config.environment}/app"
      }
      mount {
        dir  = "app"
        file = "prod"
      }
    }

    local {
      driver = "local"
      args {
        root = "./configs"
      }
    }

    env {
      driver = "env"
      args {}
      mount {
        file = ""
      }
    }
  }

  # production namespace
  namespace "production" {
    vault {
      driver = "vault"
      args {
        endpoint = "https://vault.prod.example.com"
        token    = env.VAULT_TOKEN
        path     = "secret/production/app"
      }
      mount {
        dir  = "app"
        file = "prod"
      }
    }

    s3 {
      driver = "s3"
      args {
        endpoint = "https://s3.amazonaws.com"
        bucket   = "prod-config-bucket"
        root     = "configs"
      }
    }
  }
}

# 対応する YAML 形式:
# namespaces:
#   default:
#     vault:
#       driver: vault
#       args:
#         endpoint: ${VAULT_ADDR}
#         token: ${VAULT_TOKEN}
#         path: secret/development/app
#       mount:
#         dir: app
#         file: prod
#     local:
#       driver: local
#       args:
#         root: ./configs
#   production:
#     vault:
#       driver: vault
#       args:
#         endpoint: https://vault.prod.example.com
#         ...
